{
  "配置名称": "用户ID数据查询与格式化示例",
  "触发该配置的前提": {
    "表格大小": [
      1,
      1
    ],
    "模糊行数": false,
    "模糊列数": false,
    "额外条件列表": [
      {
        "位置": [
          0,
          0
        ],
        "正则表达式": "[0-9]{3,}"
      }
    ],
    "额外条件": {
      "位置": [
        0,
        0
      ],
      "正则表达式": "[0-9]{3,}"
    }
  },
  "触发后的流程": [
    {
      "动作": "提取某一格",
      "行": 0,
      "列": 0,
      "暂存到的变量名": "id",
      "操作位置": [
        0,
        0
      ]
    },
    {
      "动作": "发网络请求",
      "方法": "POST",
      "url": "https://example.com/api/user/{{id}}",
      "header": {
        "Content-Type": "application/json"
      },
      "body": "{\"id\": \"{{id}}\"}",
      "timeout": 10000,
      "callback": {
        "newData": "res.data[0]"
      }
    },
    {
      "动作": "用户输入",
      "提示文本": "请输入要提取第几个",
      "变量名": "index",
      "默认值": ""
    },
    {
      "动作": "弹出提示框",
      "标题": "提示",
      "内容": "新内容为{{newData}}"
    },
    {
      "动作": "写入剪切板",
      "type": "table",
      "data": "{{id}},{{newData}},{{index}}"
    }
  ],
  "启用状态": true
}
