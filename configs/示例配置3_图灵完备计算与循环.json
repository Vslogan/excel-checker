{
  "配置名称": "图灵完备累加计算与条件分支示例",
  "触发该配置的前提": {
    "表格大小": [1, 1],
    "额外条件": {
      "位置": [0, 0],
      "正则表达式": "^[0-9]+$"
    }
  },
  "触发后的流程": [
    {
      "动作": "提取某一格",
      "操作位置": [0, 0],
      "暂存到的变量名": "target_n"
    },
    {
      "动作": "计算",
      "左值": "i",
      "右值": "1"
    },
    {
      "动作": "计算",
      "左值": "sum",
      "右值": "0"
    },
    {
      "动作": "计算",
      "左值": "sum",
      "右值": "sum + i"
    },
    {
      "动作": "计算",
      "左值": "i",
      "右值": "i + 1"
    },
    {
      "动作": "跳转",
      "条件": "i <= target_n",
      "目标行号": 4
    },
    {
      "动作": "如果",
      "条件": "sum >= 50",
      "是否有else": true,
      "if下面有多少个积木": 1,
      "else下面有多少个积木": 1
    },
    {
      "动作": "弹出冒泡窗",
      "内容": "累加和偏高: {{sum}} (计算至 {{target_n}})",
      "持续时间": 2000,
      "是否阻塞": false,
      "显示的屏幕": "鼠标所在屏幕",
      "显示的位置": "底部居中"
    },
    {
      "动作": "弹出冒泡窗",
      "内容": "累加和适中: {{sum}} (计算至 {{target_n}})",
      "持续时间": 2000,
      "是否阻塞": false,
      "显示的屏幕": "鼠标所在屏幕",
      "显示的位置": "底部居中"
    },
    {
      "动作": "写入剪切板",
      "type": "text",
      "data": "已计算 1 到 {{target_n}} 累加和: {{sum}}"
    }
  ],
  "启用状态": true
}
