{
  "name": "订单信息快速提取并保存",
  "trigger": {
    "table_size": [
      1,
      2
    ],
    "fuzzy_row": false,
    "fuzzy_col": false,
    "extra_conditions": [
      {
        "position": [
          0,
          0
        ],
        "regex": "^ORDER-"
      }
    ],
    "extra_condition": {
      "position": [
        0,
        0
      ],
      "regex": "^ORDER-"
    }
  },
  "workflow": [
    {
      "action": "extract_cell",
      "row": 0,
      "col": 0,
      "variable": "order_id",
      "position": [
        0,
        0
      ]
    },
    {
      "action": "extract_cell",
      "row": 0,
      "col": 1,
      "variable": "customer_name",
      "position": [
        0,
        1
      ]
    },
    {
      "action": "show_message",
      "title": "订单检测成功",
      "content": "检测到订单: {{order_id}}, 客户: {{customer_name}}"
    },
    {
      "action": "write_clipboard",
      "type": "table",
      "data": "订单号,客户姓名,状态\n{{order_id}},{{customer_name}},已复核"
    }
  ],
  "enabled": true
}
