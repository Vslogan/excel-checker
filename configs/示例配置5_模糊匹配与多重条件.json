{
  "配置名称": "模糊尺寸匹配多重条件与退出积木示例",
  "触发该配置的前提": {
    "表格大小": [1, 1],
    "模糊行数": true,
    "模糊列数": true,
    "额外条件列表": [
      {
        "位置": [0, 0],
        "正则表达式": "^START"
      },
      {
        "位置": [0, 1],
        "正则表达式": "^[0-9]+$"
      }
    ]
  },
  "触发后的流程": [
    {
      "动作": "提取某一格",
      "行": 0,
      "列": 1,
      "暂存到的变量名": "target_row_idx"
    },
    {
      "动作": "如果",
      "条件": "target_row_idx >= row",
      "then_count": 2,
      "else_count": 0
    },
    {
      "动作": "弹出冒泡窗",
      "内容": "目标行 {{target_row_idx}} 超出表格最大行数 {{row}}，提前退出流程",
      "持续时间": 2000,
      "是否阻塞": false,
      "显示的屏幕": "鼠标所在屏幕",
      "显示的位置": "底部居中"
    },
    {
      "动作": "退出"
    },
    {
      "动作": "提取某一格",
      "行": "target_row_idx",
      "列": 0,
      "暂存到的变量名": "dynamic_cell"
    },
    {
      "动作": "写入剪切板",
      "type": "text",
      "data": "成功提取第 {{target_row_idx}} 行数据: {{dynamic_cell}} (表格尺寸: {{row}}x{{column}})"
    }
  ],
  "启用状态": true
}
