{
  "配置名称": "三元运算符与多层嵌套分支示例",
  "触发该配置的前提": {
    "表格大小": [
      1,
      1
    ],
    "模糊行数": false,
    "模糊列数": false,
    "额外条件列表": [
      {
        "位置": [
          0,
          0
        ],
        "正则表达式": "^score:[0-9]+$"
      }
    ],
    "额外条件": {
      "位置": [
        0,
        0
      ],
      "正则表达式": "^score:[0-9]+$"
    }
  },
  "触发后的流程": [
    {
      "动作": "提取某一格",
      "行": 0,
      "列": 0,
      "暂存到的变量名": "raw_cell",
      "操作位置": [
        0,
        0
      ]
    },
    {
      "动作": "计算",
      "左值": "raw_score",
      "右值": "substr(raw_cell, 6, 10)"
    },
    {
      "动作": "计算",
      "左值": "grade_tier",
      "右值": "raw_score >= 90 ? 'A' : (raw_score >= 80 ? 'B' : (raw_score >= 60 ? 'C' : 'F'))"
    },
    {
      "动作": "如果",
      "条件": "raw_score >= 60",
      "then_count": 3,
      "else_count": 2
    },
    {
      "动作": "如果",
      "条件": "raw_score >= 90",
      "then_count": 1,
      "else_count": 1
    },
    {
      "动作": "弹出冒泡窗",
      "内容": "优秀学生！成绩: {{raw_score}}，等级: {{grade_tier}}",
      "持续时间": 2500,
      "是否阻塞": false,
      "显示的屏幕": "鼠标所在屏幕",
      "显示的位置": "底部居中"
    },
    {
      "动作": "弹出冒泡窗",
      "内容": "良好及格！成绩: {{raw_score}}，等级: {{grade_tier}}",
      "持续时间": 2500,
      "是否阻塞": false,
      "显示的屏幕": "鼠标所在屏幕",
      "显示的位置": "底部居中"
    },
    {
      "动作": "弹出冒泡窗",
      "内容": "未及格通知：成绩: {{raw_score}}，需补考",
      "持续时间": 2500,
      "是否阻塞": false,
      "显示的屏幕": "鼠标所在屏幕",
      "显示的位置": "底部居中"
    },
    {
      "动作": "写入剪切板",
      "type": "text",
      "data": "成绩复核: 分数={{raw_score}}, 等级={{grade_tier}}"
    }
  ],
  "启用状态": true
}
