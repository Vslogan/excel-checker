{
  "配置名称": "商品编码查询与冒泡通知",
  "触发该配置的前提": {
    "表格大小": [
      1,
      2
    ],
    "模糊行数": false,
    "模糊列数": false,
    "额外条件列表": [
      {
        "位置": [
          0,
          0
        ],
